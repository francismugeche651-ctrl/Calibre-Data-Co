# ---------------------------------------------------------------------------
# Calibre Data Co: site configuration
# Copy this file to `.env` for local development. On Netlify, add the same
# keys under Site configuration → Environment variables, then redeploy.
# Leave a value empty to switch that feature off. Never commit real secrets.
# All VITE_ variables are public (they end up in the browser bundle). Only put
# public IDs here, never API keys or passwords.
# ---------------------------------------------------------------------------

# Your live domain, no trailing slash. Used for canonical URLs, sitemap and link previews.
VITE_SITE_URL=https://www.example.com

# Contact
VITE_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (no +, spaces or dashes), e.g. 2547XXXXXXXX
VITE_WHATSAPP_NUMBER=
# Full LinkedIn URLs
VITE_LINKEDIN_COMPANY_URL=
VITE_LINKEDIN_FOUNDER_URL=

# Scheduler: "calendly" or "cal"
VITE_SCHEDULER_PROVIDER=calendly
# Calendly: full event URL, e.g. https://calendly.com/your-name/discovery-call
# Cal.com:  the link path, e.g. your-name/discovery-call (or a full https://cal.com/... URL)
VITE_SCHEDULER_URL=

# Tracking: Google Tag Manager is the recommended setup (configure GA4 + LinkedIn inside GTM).
VITE_GTM_ID=
# Fallbacks, ONLY used when VITE_GTM_ID is empty. If GTM is set, configure these inside GTM instead
# so nothing fires twice.
VITE_GA4_ID=
VITE_LINKEDIN_PARTNER_ID=

# Forms: "netlify" (default, no setup), or "webhook" to POST JSON to your own endpoint
# (e.g. a Make/Zapier/n8n webhook that writes to HubSpot).
VITE_FORM_PROVIDER=netlify
VITE_FORM_WEBHOOK_URL=
